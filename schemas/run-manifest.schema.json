{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tartarus.invalid/schemas/run-manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "run_id", "sample", "telemetry_profile", "tartarus_release", "status", "started_at", "artifacts", "visibility_gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string"},
    "run_id": {"type": "string"},
    "sample": {
      "type": "object", "additionalProperties": false, "required": ["sample_id"],
      "properties": {"sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
    },
    "telemetry_profile": {"enum": ["lightweight", "standard", "deep"]},
    "tartarus_release": {"type": "string", "minLength": 1},
    "range_id": {"type": "string", "minLength": 1},
    "execution_limit_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "remote_started_at": {"type": "string", "format": "date-time"},
    "sandbox_rebuilt_at": {"type": "string", "format": "date-time"},
    "recovery_verified": {"type": "boolean"},
    "analysis_pair_recovery": {"$ref": "#/$defs/analysis_pair_recovery"},
    "debug_session": {"type": "boolean"},
    "execution_mode": {"enum": ["native", "static_only"]},
    "sample_architecture": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "preparing", "starting", "running", "stopping", "collected", "collected_with_gaps", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "stopped_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relative_path", "media_type", "size", "collection_status", "collected_at"],
        "properties": {
          "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$"},
          "media_type": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "collection_status": {"enum": ["collected", "missing", "failed"]},
          "collected_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "visibility_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "vmid", "address"],
      "properties": {
        "name": {"type": "string"}, "vmid": {"type": "integer"}, "address": {"type": "string"}
      }
    },
    "guest_recovery": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["unknown", "tainted", "stopped", "collected", "destroyed", "redeployed", "verified", "failed"]},
        "before": {"$ref": "#/$defs/identity"},
        "current": {"$ref": "#/$defs/identity"}
      }
    },
    "analysis_pair_recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "range_id", "state", "phase", "run_id", "tainted_at", "verified_at", "guests", "failure"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "range_id": {"type": "string"},
        "state": {"enum": ["unverified", "clean", "tainted", "recovering", "quarantined"]},
        "phase": {"enum": ["unverified", "tainted", "freezing", "collecting", "destroying", "redeploying", "verifying", "verified", "failed"]},
        "run_id": {"type": ["string", "null"]},
        "tainted_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "guests": {
          "type": "object", "additionalProperties": false, "required": ["remnux", "sandbox"],
          "properties": {"remnux": {"$ref": "#/$defs/guest_recovery"}, "sandbox": {"$ref": "#/$defs/guest_recovery"}}
        },
        "failure": {"type": ["string", "null"]}
      }
    }
  }
}
