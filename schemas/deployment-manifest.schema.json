{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tartarus.invalid/schemas/deployment-manifest.schema.json",
  "title": "DeploymentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tartarus_release", "profile", "resolved_inputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tartarus_release": {"type": "string", "minLength": 1},
    "profile": {"enum": ["compact", "standard", "large"]},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range_id", "authenticated_user", "completed_at", "guests"],
      "properties": {
        "range_id": {"type": "string", "minLength": 1},
        "authenticated_user": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "format": "date-time"},
        "guests": {
          "type": "object",
          "required": ["elk", "remnux", "sandbox"],
          "additionalProperties": false,
          "properties": {
            "elk": {"$ref": "#/$defs/guest"},
            "remnux": {"$ref": "#/$defs/guest"},
            "sandbox": {"$ref": "#/$defs/guest"}
          }
        }
      }
    },
    "resolved_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "minimum_ludus_version", "build_tools", "images", "package_repositories", "components", "schemas", "policies", "controller_requirements", "artifacts", "source_files", "rendered_source_files", "blueprint", "template_build_inputs"],
      "properties": {
        "architecture": {"type": "string", "minLength": 1},
        "minimum_ludus_version": {"type": "string", "minLength": 1},
        "build_tools": {"type": "object", "minProperties": 1},
        "images": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://"}
            }
          }
        },
        "package_repositories": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^https?://"}},
        "components": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
        "schemas": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
        "policies": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "controller_requirements": {"const": "requirements.lock"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filename", "url"],
            "properties": {
              "filename": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https://"}
            }
          }
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        },
        "rendered_source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        },
        "blueprint": {"type": "string", "minLength": 1},
        "template_build_inputs": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "vmid", "kernel", "packages"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "vmid": {"type": "integer", "minimum": 100},
        "kernel": {"type": "string", "minLength": 1},
        "packages": {"type": "array", "items": {"type": "string", "pattern": "^[^\\t]+\\t[^\\t]+$"}}
      }
    }
  }
}
